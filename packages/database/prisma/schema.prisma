// ============================================================================
// Schema Prisma — Bloco 1 (Base do Sistema)
// Apenas o núcleo: organização, lojas, usuários, permissões, auditoria.
// NENHUMA tabela de evento financeiro ainda (Blocos 2–4).
// Isolamento multiloja: toda tabela operacional carrega organizationId; tabelas
// de loja carregam também marketplaceAccountId. Ver docs/bloco-1-plano.md §3.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Papel legado (Bloco 1) — mantido para não quebrar o RolesGuard/@Roles() já em
/// produção no apps/web. OWNER foi somado por cima dele (Fase 10.2): é sempre
/// tratado como super-conjunto de ADMIN pelo RolesGuard, nunca removido/rebaixado
/// por um usuário comum (ver users.service.ts). A autorização fina de verdade
/// (por módulo/ação) vive em AppRole/Permission abaixo — este enum só decide o
/// "balde" grosso que o código legado ainda consulta.
enum Role {
  OWNER
  ADMIN
  FINANCIAL
  VIEWER
}

enum EntityStatus {
  ACTIVE
  INACTIVE
}

enum IngestionSource {
  MANUAL_UPLOAD
  INTERNAL_SHOPEE_API
  SHOPEE_OFFICIAL_API
}

enum ConnectionStatus {
  NOT_CONFIGURED
  CONFIGURED
  ERROR
}

// ============================================================================
// Bloco 2 — Importação. Enums do pipeline de entrada de dados.
// ============================================================================

/// Os oito relatórios reais da Shopee + a declaração semanal (reservada) + desconhecido.
enum ReportType {
  ORDERS
  ORDER_CANCELLATION
  FAILED_DELIVERY
  RETURN_REFUND
  WALLET_TRANSACTION
  SHOPEE_ACELERA
  AFFILIATE_COMMISSION
  AFFILIATE_PERFORMANCE
  WEEKLY_INCOME_STATEMENT
  UNKNOWN
}

/// Formato REAL do arquivo, detectado pelo conteúdo (magic bytes), não pela extensão.
enum FileFormat {
  XLSX
  XLS
  CSV
}

/// Ciclo de vida de um lote de importação.
enum ImportBatchStatus {
  AWAITING_CONFIRMATION
  PROCESSING
  COMPLETED
  COMPLETED_WITH_ERRORS
  FAILED
  DISCARDED
}

/// Resultado do processamento de uma linha física.
enum ImportRowStatus {
  PENDING
  IMPORTED
  DUPLICATE
  UPDATED
  WARNING
  ERROR
  SKIPPED
}

/// Raiz do isolamento. Toda informação pertence a uma organização.
model Organization {
  id        String       @id @default(cuid())
  name      String
  status    EntityStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  marketplaceAccounts   MarketplaceAccount[]
  users                 User[]
  appRoles              AppRole[]
  auditLogs             AuditLog[]
  importBatches         ImportBatch[]
  products              Product[]
  productVariations     ProductVariation[]
  productFamilies       ProductFamily[]
  productImportBatches  ProductImportBatch[]
  marketplaceOrders     MarketplaceOrder[]
  postSaleOccurrences   PostSaleOccurrence[]
  postSaleImportBatches PostSaleImportBatch[]
  aiSetting             AiSetting?
  aiAnalyses            AiAnalysis[]
  actionPlans           ActionPlan[]
  salesImportBatches    SalesImportBatch[]
  workspaceStores       OrganizationWorkspaceStore[]

  @@map("organizations")
}

/// Loja/conta de marketplace (uma conta Shopee). MVP: "lidermolduras".
model MarketplaceAccount {
  id             String       @id @default(cuid())
  organizationId String
  marketplace    String       @default("SHOPEE")
  displayName    String
  shopId         String?
  sellerId       String?
  currency       String       @default("BRL")
  timezone       String       @default("America/Sao_Paulo")
  status         EntityStatus @default(ACTIVE)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization          Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connections           MarketplaceConnection[]
  memberships           Membership[]
  importBatches         ImportBatch[]
  dedupKeys             ImportDedupKey[]
  products              Product[]
  productVariations     ProductVariation[]
  productFamilies       ProductFamily[]
  productImportBatches  ProductImportBatch[]
  marketplaceOrders     MarketplaceOrder[]
  postSaleOccurrences   PostSaleOccurrence[]
  postSaleImportBatches PostSaleImportBatch[]
  aiAnalyses            AiAnalysis[]
  actionPlans           ActionPlan[]
  salesImportBatches    SalesImportBatch[]

  @@unique([organizationId, marketplace, displayName])
  @@index([organizationId])
  @@map("marketplace_accounts")
}

/// Conexão de fonte de dados da loja. Credenciais criptografadas; só estrutura no Bloco 1.
model MarketplaceConnection {
  id                   String           @id @default(cuid())
  marketplaceAccountId String
  sourceType           IngestionSource
  connectionStatus     ConnectionStatus @default(NOT_CONFIGURED)
  encryptedCredentials String?
  tokenExpiresAt       DateTime?
  lastSyncAt           DateTime?
  lastSuccessfulSyncAt DateTime?
  lastError            String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  marketplaceAccount MarketplaceAccount @relation(fields: [marketplaceAccountId], references: [id], onDelete: Cascade)

  @@unique([marketplaceAccountId, sourceType])
  @@index([marketplaceAccountId])
  @@map("marketplace_connections")
}

/// Usuário do sistema. Senha com Argon2. Vinculado a uma organização.
model User {
  id                  String       @id @default(cuid())
  organizationId      String
  name                String
  email               String       @unique
  passwordHash        String
  role                Role         @default(VIEWER)
  /// Perfil granular (Fase 10.2) — se nulo, o usuário só tem o que o Role legado
  /// concede (compatibilidade com registros criados antes desta fase).
  appRoleId           String?
  status              EntityStatus @default(ACTIVE)
  /// Item 26: força troca de senha no login seguinte (primeiro acesso ou
  /// redefinição feita por um administrador).
  mustChangePassword  Boolean      @default(false)
  lastLoginAt         DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  createdBy           String?
  updatedBy           String?
  /// Item 15 (multiempresa/multioperação) — restrição por NOME de
  /// empresa/operação, comparada no cliente contra as empresas que o
  /// "Sistema Marketplace — Líder" tem cadastradas no IndexedDB de quem
  /// logou. Lista vazia = sem restrição (vê todas). Documentado como
  /// fronteira client-side, não isolamento de dado real (item 48): o
  /// Postgres não conhece as empresas do IndexedDB do usuário.
  allowedCompanyNames String[]     @default([])

  organization             Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  appRole                  AppRole?                   @relation(fields: [appRoleId], references: [id], onDelete: SetNull)
  memberships              Membership[]
  refreshTokens            RefreshToken[]
  auditLogs                AuditLog[]
  permissionOverrides      UserPermissionOverride[]
  importBatches            ImportBatch[]
  productFamilies          ProductFamily[]
  productFamilyCostEntries ProductFamilyCostHistory[]
  productImportBatches     ProductImportBatch[]
  postSaleImportBatches    PostSaleImportBatch[]
  salesImportBatches       SalesImportBatch[]

  @@index([organizationId])
  @@index([appRoleId])
  @@map("users")
}

/// Acesso de um usuário a uma loja específica (isolamento fino).
model Membership {
  id                   String   @id @default(cuid())
  userId               String
  marketplaceAccountId String
  createdAt            DateTime @default(now())

  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  marketplaceAccount MarketplaceAccount @relation(fields: [marketplaceAccountId], references: [id], onDelete: Cascade)

  @@unique([userId, marketplaceAccountId])
  @@index([marketplaceAccountId])
  @@map("memberships")
}

/// Refresh token rotacionado (guardado como hash).
model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

/// Espelho por organização das stores operacionais da V1 certificada.
///
/// A V1 continua usando exatamente os mesmos registros/IDs do IndexedDB e os
/// mesmos motores financeiros no navegador. Esta tabela apenas torna cada
/// store durável e compartilhada entre o Proprietário e suas subcontas, sem
/// criar uma segunda regra de negócio ou um cálculo financeiro paralelo.
model OrganizationWorkspaceStore {
  organizationId  String
  storeName       String
  revision        Int      @default(1)
  payload         Json
  updatedByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([organizationId, storeName])
  @@index([organizationId, updatedAt])
  @@map("organization_workspace_stores")
}

/// Trilha de auditoria (quem, o quê, antes/depois). Camada paralela de
/// rastreabilidade (item 23 da Fase 10.2): nunca é lida pelos motores
/// financeiros, só gravada por eles/pela sessão — uma falha aqui não pode
/// alterar nenhum cálculo.
model AuditLog {
  id                   String   @id @default(cuid())
  organizationId       String
  userId               String?
  /// Snapshot do nome no momento da ação — sobrevive a uma renomeação/exclusão
  /// posterior do usuário (item 21).
  userNameSnapshot     String?
  action               String
  /// Módulo de origem (ex.: "contas-a-pagar", "caixa") — item 22 lista as
  /// ações mínimas obrigatórias; module ajuda a filtrar a tela de Auditoria.
  module               String?
  entityType           String
  entityId             String?
  /// "operação" (loja/marketplace) da ação, quando aplicável — item 21.
  marketplaceAccountId String?
  beforePayload        Json?
  afterPayload         Json?
  metadata             Json?
  createdAt            DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

// ============================================================================
// Fase 10.2 — RBAC granular (login/usuários/perfis/permissões do "Sistema
// Marketplace — Líder"). Aditivo: Role (enum acima) continua existindo e
// sendo o que apps/web/RolesGuard usam hoje; AppRole/Permission é a matriz
// fina por módulo×ação pedida na Fase 10.2, consultada pelo novo endpoint
// de permissões efetivas (auth/permissions.service.ts).
// ============================================================================

/// Perfil configurável por organização — os 7 templates (item 8) nascem com
/// isSystem=true (não podem ser apagados, só desativados) mais quantos perfis
/// personalizados o proprietário quiser criar (item 20).
model AppRole {
  id             String       @id @default(cuid())
  organizationId String
  /// Chave estável usada pelo seed dos templates (ex.: "OWNER", "OPERATION");
  /// nula em perfis 100% customizados.
  key            String?
  name           String
  isSystem       Boolean      @default(false)
  status         EntityStatus @default(ACTIVE)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions  AppRolePermission[]
  users        User[]

  @@unique([organizationId, key])
  @@index([organizationId])
  @@map("app_roles")
}

/// Catálogo global de permissões por módulo×ação (item 10/11) — mesma lista
/// para toda organização, nunca duplicada por tenant.
model Permission {
  id     String @id @default(cuid())
  /// ex.: "ap.pay", "financial.view" — ver PERMISSION_CATALOG em
  /// apps/api/src/auth/permission-catalog.ts (fonte única de verdade).
  key    String @unique
  module String
  label  String

  roles     AppRolePermission[]
  overrides UserPermissionOverride[]

  @@index([module])
  @@map("permissions")
}

model AppRolePermission {
  id           String @id @default(cuid())
  appRoleId    String
  permissionId String

  appRole    AppRole    @relation(fields: [appRoleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([appRoleId, permissionId])
  @@index([permissionId])
  @@map("app_role_permissions")
}

/// Item 9: perfil + exceções por usuário. allow=true concede mesmo sem o
/// perfil ter a permissão; allow=false revoga mesmo que o perfil tenha.
model UserPermissionOverride {
  id           String  @id @default(cuid())
  userId       String
  permissionId String
  allow        Boolean

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId])
  @@index([permissionId])
  @@map("user_permission_overrides")
}

// ============================================================================
// Bloco 2 — Importação
// ============================================================================

/// Lote de importação: um arquivo enviado, analisado e (após confirmação) processado.
/// Guarda TODOS os metadados exigidos no resultado da importação e a análise (prévia,
/// alertas, colunas). Isolado por organização + loja. Ver docs/bloco-2-plano.md.
model ImportBatch {
  id                   String          @id @default(cuid())
  organizationId       String
  marketplaceAccountId String
  ingestionSource      IngestionSource @default(MANUAL_UPLOAD)

  // Detecção do relatório
  reportType               ReportType @default(UNKNOWN) // efetivo (após eventual override manual)
  detectedReportType       ReportType @default(UNKNOWN) // o que a detecção automática sugeriu
  reportTypeConfidence     Float      @default(0) // 0..1
  reportTypeManualOverride Boolean    @default(false)

  // Arquivo (formato detectado pelo conteúdo, não pela extensão)
  originalFilename  String
  sanitizedFilename String
  declaredExtension String // ex.: "xls" — pode divergir do conteúdo real
  fileFormat        FileFormat
  extensionMismatch Boolean    @default(false) // ex.: .xls que na verdade é XLSX
  fileSizeBytes     Int
  fileHash          String // sha256 do conteúdo bruto — dedup em nível de arquivo
  storageKey        String // caminho no armazenamento (bytes originais intactos)

  // Estrutura detectada
  sheetName         String?
  headerRowIndex    Int? // linha física do cabeçalho (1-based)
  dataStartRowIndex Int? // linha física da 1ª linha de dados
  columnCount       Int     @default(0)
  physicalRowCount  Int     @default(0) // linhas físicas do arquivo/aba
  dataRowCount      Int     @default(0) // linhas de dados (após o cabeçalho, sem vazias)

  // Período coberto (min/max das datas de evento)
  periodStart DateTime?
  periodEnd   DateTime?

  // Resultado
  status         ImportBatchStatus @default(AWAITING_CONFIRMATION)
  totalRows      Int               @default(0) // linhas de dados consideradas
  validRows      Int               @default(0) // parseadas sem erro
  importedRows   Int               @default(0) // novas
  updatedRows    Int               @default(0) // mesma chave natural, campo mutável mudou
  duplicatedRows Int               @default(0) // hash canônico já visto
  warningRows    Int               @default(0) // importadas mas com alerta
  failedRows     Int               @default(0) // erro de parsing/validação
  processingMs   Int?
  errorMessage   String?

  // Análise (prévia, alertas, colunas) — Json para a tela mostrar antes de confirmar
  analysis Json?

  // Rastreamento
  reprocessedFromBatchId String?
  createdByUserId        String?
  startedAt              DateTime?
  completedAt            DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  marketplaceAccount MarketplaceAccount @relation(fields: [marketplaceAccountId], references: [id], onDelete: Cascade)
  createdBy          User?              @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  rows               ImportRow[]

  @@index([organizationId, createdAt])
  @@index([marketplaceAccountId, fileHash])
  @@index([marketplaceAccountId, reportType])
  @@map("import_batches")
}

/// Uma linha física preservada integralmente. rawPayload é IMUTÁVEL após a importação.
/// Nenhuma coluna original é descartada, mesmo as ainda não utilizadas.
model ImportRow {
  id            String @id @default(cuid())
  importBatchId String

  sheetName         String
  physicalRowNumber Int // número da linha no arquivo (1-based)
  logicalRowNumber  Int // número da linha de dados (1-based, ignorando cabeçalho/metadados)

  rawPayload          Json // todas as colunas originais (por posição e por nome), texto bruto
  normalizedPayload   Json? // campos normalizados na 1ª versão
  detectedIdentifiers Json? // ids detectados (orderId, returnId, redemptionId, etc.)
  externalOrderId     String?
  externalReference   String?

  rawHash              String // sha256 da linha bruta
  canonicalHash        String // sha256 do conjunto canônico por relatório (§9.1)
  canonicalHashVersion String @default("v1")

  processingStatus ImportRowStatus @default(PENDING)
  warnings         Json?
  errors           Json?

  createdAt DateTime @default(now())

  batch ImportBatch @relation(fields: [importBatchId], references: [id], onDelete: Cascade)

  @@unique([importBatchId, physicalRowNumber])
  @@index([importBatchId, processingStatus])
  @@index([canonicalHash])
  @@map("import_rows")
}

/// Livro de identidade para deduplicação entre lotes (e períodos sobrepostos).
/// Uma entrada por (loja, relatório, hash canônico). Permite reconhecer o que já
/// existe sem, ainda, materializar as tabelas de eventos financeiros (Bloco 3).
/// Ver data-contract.md §9.
model ImportDedupKey {
  id                   String     @id @default(cuid())
  marketplaceAccountId String
  reportType           ReportType
  canonicalHash        String
  naturalKey           String // chave natural documentada por relatório (para detectar atualização)
  firstSeenBatchId     String
  lastSeenBatchId      String
  firstSeenRowId       String?
  occurrences          Int        @default(1)
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  marketplaceAccount MarketplaceAccount @relation(fields: [marketplaceAccountId], references: [id], onDelete: Cascade)

  @@unique([marketplaceAccountId, reportType, canonicalHash])
  @@index([marketplaceAccountId, reportType, naturalKey])
  @@map("import_dedup_keys")
}

// ============================================================================
// Bloco 3 — Produtos, Variações/SKUs, Famílias e Custos.
//
// Entidade principal = ANÚNCIO Shopee (Product), identificado por shopeeProductId
// ("ID do Produto"). Cada anúncio agrupa VARIAÇÕES (ProductVariation), cada uma
// com seu SKU, preço e estoque próprios. A FAMÍLIA (ProductFamily) é a unidade
// interna de CUSTO: várias variações apontam para uma família; o custo mora na
// família (com HISTÓRICO, para não corromper a análise de pedidos antigos).
//
// Regra central: SKU → variação → família → custo vigente.
// Regra de reimportação: campos importados da Shopee (preço cheio, estoque, nome)
// são sincronizados; campos internos (família, preço de fechamento, notas) NUNCA
// são sobrescritos por uma reimportação.
// ============================================================================

/// Família de produtos — unidade interna de CUSTO. Ver prompt §8, §9, §22.
model ProductFamily {
  id                   String       @id @default(cuid())
  organizationId       String
  marketplaceAccountId String
  name                 String
  /// Nome normalizado (sem acento, minúsculo) — garante unicidade e busca estável.
  normalizedName       String
  internalCode         String?
  notes                String?
  status               EntityStatus @default(ACTIVE)

  // Custo vigente — desnormalizado a partir do histórico para leitura rápida.
  // null = "custo não informado" (exibido explicitamente na interface).
  currentCostAmount        Decimal?  @db.Decimal(14, 4)
  currentCostEffectiveFrom DateTime?
  costUpdatedAt            DateTime?

  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization       Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  marketplaceAccount MarketplaceAccount         @relation(fields: [marketplaceAccountId], references: [id], onDelete: Cascade)
  createdBy          User?                      @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  costHistory        ProductFamilyCostHistory[]
  variations         ProductVariation[]

  @@unique([marketplaceAccountId, normalizedName])
  @@index([organizationId])
  @@index([marketplaceAccountId, status])
  @@map("product_families")
}

/// Histórico de custo da família — preserva o custo antigo (prompt §9). O custo
/// vigente em uma data D = a entrada de maior effectiveFrom com effectiveFrom <= D.
model ProductFamilyCostHistory {
  id              String   @id @default(cuid())
  familyId        String
  costAmount      Decimal  @db.Decimal(14, 4)
  effectiveFrom   DateTime
  note            String?
  createdByUserId String?
  createdAt       DateTime @default(now())

  family    ProductFamily @relation(fields: [familyId], references: [id], onDelete: Cascade)
  createdBy User?         @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([familyId, effectiveFrom])
  @@map("product_family_cost_history")
}

/// Anúncio Shopee (entidade principal). Agrupa variações. Ver prompt §5, §16.
model Product {
  id                   String       @id @default(cuid())
  organizationId       String
  marketplaceAccountId String
  /// "ID do Produto" — identificador único do anúncio na Shopee.
  shopeeProductId      String
  name                 String
  status               EntityStatus @default(ACTIVE)

  // Agregados denormalizados (recalculados na importação e na classificação) —
  // permitem busca/ordenação/paginação eficientes com milhares de anúncios.
  variationCount                Int      @default(0)
  totalStock                    Int      @default(0)
  minPrice                      Decimal? @db.Decimal(14, 4)
  maxPrice                      Decimal? @db.Decimal(14, 4)
  variationsWithoutFamily       Int      @default(0)
  variationsWithoutClosingPrice Int      @default(0)

  firstImportBatchId String?
  lastImportBatchId  String?
  firstSeenAt        DateTime @default(now())
  lastSeenAt         DateTime @default(now())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  marketplaceAccount MarketplaceAccount @relation(fields: [marketplaceAccountId], references: [id], onDelete: Cascade)
  variations         ProductVariation[]

  @@unique([marketplaceAccountId, shopeeProductId])
  @@index([organizationId])
  @@index([marketplaceAccountId, name])
  @@index([marketplaceAccountId, variationsWithoutFamily])
  @@map("products")
}

/// Variação / SKU (entidade filha do anúncio). Mistura dados da Shopee (mutáveis
/// na reimportação) com dados INTERNOS (família, preço de fechamento) que a
/// reimportação nunca sobrescreve. Ver prompt §5, §6, §10–§16.
model ProductVariation {
  id                   String @id @default(cuid())
  organizationId       String
  marketplaceAccountId String
  productId            String

  /// "Variante Identificador" (pode vir vazio em anúncios de variação única).
  shopeeVariationId String
  /// Chave estável da variação DENTRO do anúncio (variante id, ou SKU, ou sentinela).
  variationKey      String

  // --- Dados importados da Shopee (sincronizados na reimportação) ---
  variationName   String?
  sku             String?
  referenceSku    String?
  gtin            String?
  /// "Preço" da planilha = preço cheio/cadastrado na Shopee (NÃO é o de fechamento).
  shopeeFullPrice Decimal? @db.Decimal(14, 4)
  sellerStock     Int?
  failReason      String?

  // --- Dados INTERNOS (nunca sobrescritos por reimportação) ---
  /// Preço de fechamento/com desconto — decisão nossa. null = "não informado".
  closingPrice  Decimal? @db.Decimal(14, 4)
  familyId      String?
  internalNotes String?

  firstImportBatchId String?
  lastImportBatchId  String?
  firstSeenAt        DateTime @default(now())
  lastSeenAt         DateTime @default(now())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  organization       Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  marketplaceAccount MarketplaceAccount       @relation(fields: [marketplaceAccountId], references: [id], onDelete: Cascade)
  product            Product                  @relation(fields: [productId], references: [id], onDelete: Cascade)
  family             ProductFamily?           @relation(fields: [familyId], references: [id], onDelete: SetNull)
  occurrenceItems    PostSaleOccurrenceItem[]
  orderItems         MarketplaceOrderItem[]

  @@unique([productId, variationKey])
  @@index([marketplaceAccountId])
  @@index([marketplaceAccountId, sku])
  @@index([familyId])
  @@map("product_variations")
}

/// Histórico de importações do catálogo de produtos (auditoria, prompt §18).
model ProductImportBatch {
  id                   String          @id @default(cuid())
  organizationId       String
  marketplaceAccountId String
  ingestionSource      IngestionSource @default(MANUAL_UPLOAD)

  originalFilename  String
  sanitizedFilename String
  declaredExtension String
  fileFormat        FileFormat
  fileSizeBytes     Int
  fileHash          String
  storageKey        String

  sheetName         String?
  headerRowIndex    Int?
  dataStartRowIndex Int?
  columnCount       Int     @default(0)
  physicalRowCount  Int     @default(0)
  dataRowCount      Int     @default(0)

  status ImportBatchStatus @default(PROCESSING)

  // Resultado da sincronização (prompt §17).
  totalRows        Int     @default(0)
  productsSeen     Int     @default(0)
  variationsSeen   Int     @default(0)
  newProducts      Int     @default(0)
  newVariations    Int     @default(0)
  updatedRecords   Int     @default(0)
  unchangedRecords Int     @default(0)
  ignoredRows      Int     @default(0)
  errorRows        Int     @default(0)
  processingMs     Int?
  errorMessage     String?

  errors   Json?
  analysis Json?

  createdByUserId String?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  marketplaceAccount MarketplaceAccount @relation(fields: [marketplaceAccountId], references: [id], onDelete: Cascade)
  createdBy          User?              @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([marketplaceAccountId, fileHash])
  @@map("product_import_batches")
}

// ============================================================================
// Bloco 4 — Pós-venda & Perdas (devoluções, reembolsos, cancelamentos, falhas
// de entrega, disputas). Regra estrutural: PEDIDO ≠ OCORRÊNCIA ≠ ITEM.
//
// Fluxo: o Bloco 2 já importa e preserva as LINHAS BRUTAS dos três relatórios
// (return_refund, cancelamento, falha de entrega). Este módulo MATERIALIZA
// essas linhas em Pedido/Ocorrência/Item, conecta ao catálogo (SKU→variação→
// produto→família) e habilita análise/achados. Financeiro por OCORRÊNCIA (nunca
// somar linhas multi-SKU ingenuamente).
// ============================================================================

/// Tipo de ocorrência de pós-venda.
enum OccurrenceType {
  RETURN_REFUND
  ORDER_CANCELLATION
  FAILED_DELIVERY
  DISPUTE
  COMPENSATION
}

/// Pedido (a venda). Hub que conectará venda, financeiro, Ads, logística etc.
/// Identificado por (loja, ID do pedido). Um pedido pode ter várias ocorrências.
model MarketplaceOrder {
  id                   String @id @default(cuid())
  organizationId       String
  marketplaceAccountId String
  externalOrderId      String // "ID do pedido"

  // --- Status (§13: preserva original + normalizado) ---
  orderStatus        String? // status_original_marketplace (texto cru da Shopee)
  normalizedStatus   String? // NAO_PAGO | A_ENVIAR | ENVIADO | CONCLUIDO | CANCELADO
  cancelReason       String?
  returnRefundStatus String?

  // --- Logística ---
  trackingNumber String?
  shippingOption String?
  shippingMethod String?

  // --- Datas ---
  orderCreatedAt DateTime?
  paidAt         DateTime?
  shipByDate     DateTime?
  shippedAt      DateTime?
  deliveredAt    DateTime?
  completedAt    DateTime?
  cancelledAt    DateTime?

  // --- Financeiro do PEDIDO (persistido UMA vez — §17) ---
  itemsSubtotal       Decimal? @db.Decimal(14, 2) // soma dos subtotais de itens
  totalAmount         Decimal? @db.Decimal(14, 2) // "Valor Total"
  grandTotal          Decimal? @db.Decimal(14, 2) // "Total global"
  buyerPaidShipping   Decimal? @db.Decimal(14, 2)
  reverseShippingFee  Decimal? @db.Decimal(14, 2)
  transactionFee      Decimal? @db.Decimal(14, 2)
  commissionGross     Decimal? @db.Decimal(14, 2)
  commissionNet       Decimal? @db.Decimal(14, 2)
  serviceFeeGross     Decimal? @db.Decimal(14, 2)
  serviceFeeNet       Decimal? @db.Decimal(14, 2)
  estimatedShipping   Decimal? @db.Decimal(14, 2)
  sellerDiscountTotal Decimal? @db.Decimal(14, 2)

  // --- Resultado estimado (determinístico; recalculado na importação) ---
  marketplaceFeesTotal Decimal? @db.Decimal(14, 2)
  productCostTotal     Decimal? @db.Decimal(14, 2)
  estimatedResult      Decimal? @db.Decimal(14, 2)
  estimatedMarginPct   Decimal? @db.Decimal(9, 4)
  costPending          Boolean  @default(false) // algum item sem custo/sem vínculo

  unitsTotal Int? // "Número de produtos pedidos" / soma de quantidades
  itemCount  Int  @default(0)

  // --- Cliente / entrega (PII — nunca enviado à LLM) ---
  buyerUsername String?
  recipientName String?
  phone         String?
  address       String?
  city          String?
  district      String?
  uf            String?
  country       String?
  cep           String?
  buyerNote     String?
  note          String?

  /// Linha bruta completa por pedido (auditoria §18/§37) — cabeçalho→valor.
  rawPayload Json?

  firstImportBatchId String?
  lastImportBatchId  String?
  firstSeenAt        DateTime @default(now())
  lastSeenAt         DateTime @default(now())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  organization       Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  marketplaceAccount MarketplaceAccount     @relation(fields: [marketplaceAccountId], references: [id], onDelete: Cascade)
  occurrences        PostSaleOccurrence[]
  items              MarketplaceOrderItem[]
  statusHistory      OrderStatusHistory[]

  @@unique([marketplaceAccountId, externalOrderId])
  @@index([organizationId])
  @@index([marketplaceAccountId, normalizedStatus])
  @@index([marketplaceAccountId, orderCreatedAt])
  @@index([trackingNumber])
  @@map("marketplace_orders")
}

/// Item (linha de produto) de um pedido. Vários itens podem pertencer ao mesmo
/// pedido (§15/§16). Identidade estável por itemKey dentro do pedido.
model MarketplaceOrderItem {
  id             String @id @default(cuid())
  organizationId String
  orderId        String
  /// Identidade estável do item dentro do pedido (SKU normalizado + posição de desempate).
  itemKey        String
  lineIndex      Int    @default(0)

  productName   String?
  sku           String?
  mainSkuRef    String?
  variationName String?

  originalPrice   Decimal? @db.Decimal(14, 2)
  agreedPrice     Decimal? @db.Decimal(14, 2) // PREÇO REAL DA VENDA (§25)
  quantity        Int      @default(1)
  productSubtotal Decimal? @db.Decimal(14, 2)
  sellerDiscount1 Decimal? @db.Decimal(14, 2)
  sellerDiscount2 Decimal? @db.Decimal(14, 2)
  weightSku       Decimal? @db.Decimal(14, 4)

  // --- Vínculo com Produtos/Família (§21) ---
  productVariationId String?
  skuLinked          Boolean @default(false)

  // --- Snapshot de custo (§23) — congelado no momento da venda ---
  costUnit        Decimal?  @db.Decimal(14, 4)
  costTotal       Decimal?  @db.Decimal(14, 2)
  costSource      String? // FAMILY | NONE
  costFamilyId    String?
  costReferenceAt DateTime?
  costMissing     Boolean   @default(false) // vinculado mas sem custo cadastrado

  // --- Rateio determinístico (§29) ---
  allocatedFees      Decimal? @db.Decimal(14, 2)
  estimatedResult    Decimal? @db.Decimal(14, 2)
  estimatedMarginPct Decimal? @db.Decimal(9, 4)

  /// Linha bruta completa do item (auditoria §18/§37).
  rawPayload Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order            MarketplaceOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productVariation ProductVariation? @relation(fields: [productVariationId], references: [id], onDelete: SetNull)

  @@unique([orderId, itemKey])
  @@index([organizationId])
  @@index([sku])
  @@index([productVariationId])
  @@map("marketplace_order_items")
}

/// Histórico de alterações relevantes de um pedido detectadas em reimportações (§12).
model OrderStatusHistory {
  id            String   @id @default(cuid())
  orderId       String
  field         String // status | trackingNumber | ...
  oldValue      String?
  newValue      String?
  importBatchId String?
  observedAt    DateTime @default(now())

  order MarketplaceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, observedAt])
  @@map("order_status_history")
}

/// Lote de importação de PEDIDOS (§20) — contadores de upsert e metadados.
model SalesImportBatch {
  id                   String @id @default(cuid())
  organizationId       String
  marketplaceAccountId String

  originalFilename String
  fileHash         String
  parserVersion    String @default("v1")

  rowsProcessed   Int @default(0)
  ordersSeen      Int @default(0)
  newOrders       Int @default(0)
  updatedOrders   Int @default(0)
  unchangedOrders Int @default(0)
  itemsSeen       Int @default(0)
  newItems        Int @default(0)
  updatedItems    Int @default(0)
  unchangedItems  Int @default(0)
  errors          Int @default(0)
  warnings        Int @default(0)

  periodStart DateTime?
  periodEnd   DateTime?

  createdByUserId String?
  createdAt       DateTime @default(now())

  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  marketplaceAccount MarketplaceAccount @relation(fields: [marketplaceAccountId], references: [id], onDelete: Cascade)
  createdBy          User?              @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, marketplaceAccountId, createdAt])
  @@map("sales_import_batches")
}

/// Ocorrência de pós-venda. Os VALORES financeiros (reembolso, compensação) vivem
/// AQUI (nível da ocorrência), nunca somados por item — evita a soma ingênua
/// multi-SKU. `externalReturnId` preservado para devoluções (um pedido pode ter
/// várias devoluções). `naturalKey` identifica a ocorrência entre importações.
model PostSaleOccurrence {
  id                   String         @id @default(cuid())
  organizationId       String
  marketplaceAccountId String
  orderId              String
  type                 OccurrenceType

  /// Chave natural por tipo (returnId p/ devolução; orderId p/ cancel/falha).
  naturalKey       String
  externalReturnId String? // "ID da Devolução"
  externalOrderId  String // redundante p/ consulta rápida

  // --- DADO SHOPEE (importado, auditável — nunca sobrescrito silenciosamente) ---
  status        String? // status original da Shopee
  reason        String? // motivo original Shopee
  reasonRevised String? // motivo revisado Shopee
  resolution    String? // "Solução para Retorno e Reembolso"
  returnType    String?
  disputeReason String?
  sellerNote    String?

  // Financeiro AO NÍVEL DA OCORRÊNCIA (uma vez por ocorrência).
  requestedRefundAmount    Decimal? @db.Decimal(14, 2)
  sellerCompensationAmount Decimal? @db.Decimal(14, 2)
  buyerPaidAmount          Decimal? @db.Decimal(14, 2)

  occurredAt     DateTime? // data do evento (criação do pedido/finalização)
  trackingNumber String?
  trackingStatus String?

  // --- CONTROLE INTERNO (operacional — informado pela equipe, §8/§9/§15/§21) ---
  internalStatus       String   @default("NOVA") // NOVA|ANALISE|AGUARDANDO_EVIDENCIA|AGUARDANDO_RETORNO|EM_TRANSITO|RECEBIDO|EM_DISPUTA|AGUARDANDO_RESULTADO|RESOLVIDA|ENCERRADA|EXIGE_ACAO
  priority             String   @default("MEDIA") // BAIXA|MEDIA|ALTA|URGENTE
  ownerName            String? // responsável operacional
  internalCause        String? // causa interna (≠ motivo Shopee)
  causeFamily          String? // família da causa (ex.: "Avaria / Embalagem")
  responsibility       String   @default("NAO_IDENTIFICADA") // OPERACAO|SHOPEE|LOGISTICA|COMPRADOR|COMPARTILHADA|NAO_IDENTIFICADA
  merchandiseStatus    String   @default("DESCONHECIDO") // DESCONHECIDO|CLIENTE_POSSUI|RETORNO_DISPENSADO|AGUARDANDO_POSTAGEM|EM_TRANSITO|RECEBIDO|EXTRAVIADO|PERDIDO
  merchandiseCondition String? // REAPROVEITAVEL|REQUER_RETRABALHO|AVARIADO|PERDA_TOTAL
  recoverableValue     Decimal? @db.Decimal(14, 2) // valor recuperável estimado do produto
  operatorNotes        String?
  checklist            Json? // [{text, done}]

  // --- DISPUTA operacional (§11/§12) ---
  hasDispute             Boolean   @default(false)
  disputeStatus          String    @default("NAO_INICIADA") // NAO_INICIADA|POSSIVEL|EM_PREPARACAO|RESPONDIDA|AGUARDANDO_SHOPEE|GANHA|PARCIAL|PERDIDA|PRAZO_PERDIDO|CANCELADA
  disputeDeadline        DateTime?
  disputeRespondedAt     DateTime?
  disputeContestedAmount Decimal?  @db.Decimal(14, 2)
  disputeRecoveredAmount Decimal?  @db.Decimal(14, 2)
  disputeNote            String?

  // --- CÁLCULO desnormalizado (motor determinístico §16/§19 — recalculado) ---
  refundedTotal       Decimal? @db.Decimal(14, 2)
  additionalCostTotal Decimal? @db.Decimal(14, 2) // frete reverso + retrabalho + outros custos
  recoveredTotal      Decimal? @db.Decimal(14, 2) // compensação + recuperação disputa + valor recuperável
  knownNetImpact      Decimal? @db.Decimal(14, 2) // impacto líquido conhecido
  cmvAvailable        Boolean  @default(false)

  sourceReportType   String // ORDERS/RETURN_REFUND/ORDER_CANCELLATION/FAILED_DELIVERY
  firstImportBatchId String?
  lastImportBatchId  String?
  firstSeenAt        DateTime @default(now())
  lastSeenAt         DateTime @default(now())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  organization       Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  marketplaceAccount MarketplaceAccount         @relation(fields: [marketplaceAccountId], references: [id], onDelete: Cascade)
  order              MarketplaceOrder           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  items              PostSaleOccurrenceItem[]
  statusHistory      OccurrenceStatusHistory[]
  financialEvents    OccurrenceFinancialEvent[]
  activities         OccurrenceActivity[]

  @@unique([marketplaceAccountId, type, naturalKey])
  @@index([organizationId, type])
  @@index([marketplaceAccountId, occurredAt])
  @@index([marketplaceAccountId, internalStatus])
  @@index([marketplaceAccountId, disputeStatus])
  @@index([orderId])
  @@map("post_sale_occurrences")
}

/// Evento financeiro de uma ocorrência (§13/§17). Idempotente por dedupeKey — uma
/// compensação importada e reimportada não entra duas vezes. Direção COST/RECOVERY.
model OccurrenceFinancialEvent {
  id              String   @id @default(cuid())
  organizationId  String
  occurrenceId    String
  type            String // REEMBOLSO_SOLICITADO|REEMBOLSO_PAGO|FRETE_REVERSO|FRETE_ADICIONAL|COMPENSACAO_SHOPEE|RECUPERACAO_DISPUTA|PRODUTO_RECUPERADO|PRODUTO_PERDIDO|CUSTO_RETRABALHO|AJUSTE_MANUAL|OUTRO
  direction       String // COST | RECOVERY | NEUTRAL
  amount          Decimal  @db.Decimal(14, 2)
  occurredAt      DateTime @default(now())
  source          String   @default("MANUAL") // MANUAL | IMPORT
  externalRef     String? // referência de origem (para idempotência de importados)
  importBatchId   String?
  createdByUserId String?
  createdByName   String?
  note            String?
  /// Chave de deduplicação estável (idempotência §17).
  dedupeKey       String
  createdAt       DateTime @default(now())

  occurrence PostSaleOccurrence @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)

  @@unique([occurrenceId, dedupeKey])
  @@index([organizationId])
  @@index([occurrenceId])
  @@map("occurrence_financial_events")
}

/// Timeline operacional/auditoria (§10/§29): toda mudança manual ou comentário.
model OccurrenceActivity {
  id           String   @id @default(cuid())
  occurrenceId String
  kind         String // CHANGE | COMMENT | FINANCIAL | DISPUTE | STATUS
  field        String?
  oldValue     String?
  newValue     String?
  message      String?
  userId       String?
  userName     String?
  createdAt    DateTime @default(now())

  occurrence PostSaleOccurrence @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)

  @@index([occurrenceId, createdAt])
  @@map("occurrence_activities")
}

/// Item (SKU/variação/produto afetado) de uma ocorrência. Quantidades e preço
/// unitário AQUI; conectado ao catálogo por SKU (variação) quando houver match.
model PostSaleOccurrenceItem {
  id             String @id @default(cuid())
  occurrenceId   String
  organizationId String

  /// Chave estável do item dentro da ocorrência (SKU ou índice) — idempotência.
  itemKey       String
  sku           String?
  parentSku     String?
  productName   String?
  variationName String?
  quantity      Int?
  unitPrice     Decimal? @db.Decimal(14, 2)

  // Conexão com o catálogo (módulo Produtos). Null = "SKU NÃO VINCULADO".
  productVariationId String?
  skuLinked          Boolean @default(false)

  /// Linha bruta original preservada (camada RAW, §7).
  rawPayload Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  occurrence       PostSaleOccurrence @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)
  productVariation ProductVariation?  @relation(fields: [productVariationId], references: [id], onDelete: SetNull)

  @@unique([occurrenceId, itemKey])
  @@index([occurrenceId])
  @@index([organizationId, skuLinked])
  @@index([sku])
  @@map("post_sale_occurrence_items")
}

// ============================================================================
// Bloco 4 — camada de Inteligência (IA plugável) e Plano de Ação.
// ============================================================================

/// Configuração de IA por organização. A credencial é criptografada e NUNCA vai
/// para o frontend/bundle. Provider desacoplado (§45–§47).
model AiSetting {
  id              String   @id @default(cuid())
  organizationId  String   @unique
  provider        String   @default("anthropic") // anthropic | openai
  model           String   @default("claude-sonnet-4-5")
  encryptedApiKey String?
  enabled         Boolean  @default(false)
  updatedByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("ai_settings")
}

/// Histórico/cache de análises da IA (§56–§57). Toda análise é rastreável:
/// contexto determinístico de entrada, resposta, evidências, prompt, tokens.
model AiAnalysis {
  id                   String   @id @default(cuid())
  organizationId       String
  marketplaceAccountId String
  functionKey          String // executive_summary | findings | investigator | chat | ...
  promptVersion        String   @default("v1")
  provider             String
  model                String
  scopeKey             String // hash do período/filtros (cache)
  input                Json
  output               Json?
  evidences            Json?
  status               String   @default("OK") // OK | INVALID | ERROR
  tokensInput          Int?
  tokensOutput         Int?
  costUsd              Decimal? @db.Decimal(12, 6)
  errorMessage         String?
  createdByUserId      String?
  createdAt            DateTime @default(now())

  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  marketplaceAccount MarketplaceAccount @relation(fields: [marketplaceAccountId], references: [id], onDelete: Cascade)

  @@index([organizationId, functionKey, scopeKey])
  @@index([marketplaceAccountId, createdAt])
  @@map("ai_analyses")
}

/// Plano de ação (§63–§73). Nasce de achados/hipóteses/IA, mas sempre confirmado
/// pelo usuário. Guarda baseline/meta e a data de implantação (marco de medição).
model ActionPlan {
  id                   String    @id @default(cuid())
  organizationId       String
  marketplaceAccountId String
  title                String
  description          String?
  origin               String? // user | finding | ai | cause | sku | ...
  status               String    @default("SUGGESTED") // §65
  priority             String    @default("MEDIUM")
  ownerName            String?
  dueDate              DateTime?
  implementedAt        DateTime?
  reviewAt             DateTime?
  indicator            String?
  baselineValue        Decimal?  @db.Decimal(14, 4)
  targetValue          Decimal?  @db.Decimal(14, 4)
  financialImpact      Decimal?  @db.Decimal(14, 2)
  notes                String?
  relatedSkus          Json?
  relatedFindings      Json?
  createdByUserId      String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  organization       Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  marketplaceAccount MarketplaceAccount        @relation(fields: [marketplaceAccountId], references: [id], onDelete: Cascade)
  checklist          ActionPlanChecklistItem[]

  @@index([organizationId, status])
  @@map("action_plans")
}

model ActionPlanChecklistItem {
  id        String   @id @default(cuid())
  planId    String
  text      String
  done      Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  plan ActionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId])
  @@map("action_plan_checklist_items")
}

/// Trajetória de status observada da ocorrência (mudanças entre importações).
model OccurrenceStatusHistory {
  id             String   @id @default(cuid())
  occurrenceId   String
  observedAt     DateTime @default(now())
  previousStatus String?
  newStatus      String?
  importBatchId  String?
  createdAt      DateTime @default(now())

  occurrence PostSaleOccurrence @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)

  @@index([occurrenceId, observedAt])
  @@map("occurrence_status_history")
}

/// Histórico/execução de importação de pós-venda (por tipo de relatório).
model PostSaleImportBatch {
  id                   String         @id @default(cuid())
  organizationId       String
  marketplaceAccountId String
  occurrenceType       OccurrenceType

  originalFilename  String
  sanitizedFilename String
  fileFormat        FileFormat
  fileSizeBytes     Int
  fileHash          String
  storageKey        String
  parserVersion     String     @default("v1")

  sheetName        String?
  headerRowIndex   Int?
  physicalRowCount Int       @default(0)
  dataRowCount     Int       @default(0)
  periodStart      DateTime?
  periodEnd        DateTime?

  status ImportBatchStatus @default(PROCESSING)

  totalRows            Int     @default(0)
  occurrencesSeen      Int     @default(0)
  itemsSeen            Int     @default(0)
  newOccurrences       Int     @default(0)
  updatedOccurrences   Int     @default(0)
  unchangedOccurrences Int     @default(0)
  ordersTouched        Int     @default(0)
  unlinkedItems        Int     @default(0)
  errorRows            Int     @default(0)
  processingMs         Int?
  errorMessage         String?
  errors               Json?

  createdByUserId String?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  marketplaceAccount MarketplaceAccount @relation(fields: [marketplaceAccountId], references: [id], onDelete: Cascade)
  createdBy          User?              @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([marketplaceAccountId, occurrenceType])
  @@index([marketplaceAccountId, fileHash])
  @@map("post_sale_import_batches")
}
